# ============================================================
# Autobot Trader bootstrap configuration
# Everything else (broker keys, LLM/STT providers, risk limits,
# channels) is configured from the dashboard and stored encrypted
# in the database.
# ============================================================

# Where to store data. SQLite (default) needs nothing else; for the
# Docker deployment this is overridden to Postgres in docker-compose.yml.
AUTOBOT_DATABASE_URL=sqlite+aiosqlite:///./autobot.db

# REQUIRED. Encrypts all secrets at rest (broker keys, Telegram session, LLM keys).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTOBOT_MASTER_KEY=

# Initial dashboard password (change it after first login from Settings).
AUTOBOT_ADMIN_PASSWORD=change-me

# Background services. Keep everything off until configured from the dashboard.
AUTOBOT_ENABLE_TELEGRAM=false
AUTOBOT_ENABLE_YOUTUBE=false
AUTOBOT_ENABLE_TRACKER=false
AUTOBOT_ENABLE_SCRIP_SYNC=false

AUTOBOT_HOST=0.0.0.0
AUTOBOT_PORT=8000
AUTOBOT_LOG_LEVEL=INFO

# Postgres credentials used by docker-compose.yml
POSTGRES_USER=autobot
POSTGRES_PASSWORD=autobot
POSTGRES_DB=autobot
